{
  "name": "ai-lodestone",
  "version": "0.1.0",
  "description": "Launch, record and resume Claude Code sessions from Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs dev",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "install-plugin": "npm run build && node scripts/install.mjs",
    "version": "node scripts/version-bump.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "1.14.4",
    "tslib": "^2.6.0",
    "typescript": "^5.6.0"
  }
}
